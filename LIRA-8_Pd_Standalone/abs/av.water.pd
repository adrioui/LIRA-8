#N canvas 0 0 560 420 10;
#X obj 20 20 inlet;
#X obj 20 50 sel 0 1;
#X msg 20 90 stop;
#X msg 20 120 open ../av/video_audio.wav;
#X obj 200 120 del 200;
#X msg 200 150 1 \, start;
#X obj 20 200 readsf~ 1 1;
#X obj 20 240 nn~ water_pondbrain_b2048_r48000_z16;
#X obj 20 280 *~ 0.7;
#X obj 20 320 dac~ 1 2;
#X obj 300 220 print WATER;
#X text 20 350 the water model is trained at 48kHz. run pd at -r 48000 or the pitch shifts.;
#X text 20 368 this chain is independent of the LIRA-8 bus. it only shares the output.;
#X text 20 386 readsf opens on a helper thread so start is delayed 200 ms.;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 1 3 0;
#X connect 1 1 4 0;
#X connect 2 0 6 0;
#X connect 3 0 6 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 7 1 10 0;
#X connect 8 0 9 0;
#X connect 8 0 9 1;
#N canvas 0 0 560 440 10;
#X obj 20 20 inlet;
#X obj 20 50 sel 0 1;
#X msg 20 90 stop;
#X msg 20 120 open ../av/video_audio.wav;
#X obj 200 120 del 200;
#X msg 200 150 1 \, start;
#X obj 20 200 readsf~ 1 1;
#X obj 20 240 nn~ water_pondbrain_b2048_r48000_z16;
#X obj 20 280 *~ 0.7;
#X obj 20 320 dac~ 1 2;
#X obj 300 220 print WATER;
#X obj 20 360 loadbang;
#X msg 120 360 bufsize 16384;
#X obj 300 60 switch~;
#X text 20 390 the water model is trained at 48kHz. run pd at -r 48000 or the pitch shifts.;
#X text 20 408 this chain is independent of the LIRA-8 bus. it only shares the output.;
#X text 20 426 switch~ gates torch inference. the model costs nothing while this toggle is off.;
#X connect 0 0 1 0;
#X connect 0 0 13 0;

#N canvas 0 0 560 520 10;
#X text 20 10 WATER -- video soundtrack resynthesized as water. Always looping from load.;
#X text 20 26 Input lives in RAM (table). No disk streaming. Loop replays from done-bang.;
#X text 20 42 WATER toggle mutes the voice AND switches torch inference off. Zero cost when off.;
#X text 20 58 Model trained at 48kHz: launch with ./run-av.sh (-r 48000).;
#X obj 20 100 inlet;
#X obj 20 130 sel 0 1;
#X obj 20 160 t b b;
#X msg 20 190 stop;
#X msg 90 190 0;
#X obj 20 220 t b b;
#X msg 20 250 bang;
#X msg 90 250 1;
#X obj 170 250 print WATER;
#X obj 320 100 loadbang;
#X msg 320 130 read -resize ../av/video_audio.wav tab_water;
#X obj 320 160 soundfiler;
#X obj 320 190 t b b;
#X msg 320 220 bang;
#X msg 320 250 1;
#X obj 20 300 table tab_water 1056000;
#X obj 20 330 tabplay~ tab_water;
#N canvas 100 100 400 200 voice 0;
#X obj 30 40 inlet~;
#X obj 30 70 nn~ water_pondbrain_b2048_r48000_z16;
#X obj 30 100 *~ 0.7;
#X obj 30 130 outlet~;
#X obj 200 40 inlet;
#X obj 200 70 switch~;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 4 0 5 0;
#X restore 20 360 pd voice;
#X obj 20 390 dac~ 1 2;
#X obj 300 330 env~ 2048;
#X obj 300 360 clip 0 100;
#X obj 300 390 * 1.27;
#X obj 300 420 s water-lvl;
#X obj 20 330 *~ 0.5;

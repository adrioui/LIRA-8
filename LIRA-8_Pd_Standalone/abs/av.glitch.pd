#N canvas 0 0 1400 2000 10;
#X text 40 10 VIDEO GLITCH - video always visible, glitched by LIRA, colony on top;
#X text 40 25 MAP: vol->brightness drv->contrast sharp->color vibrato->hue;
#X text 40 40 mod->curve feedback->alpha del-mod->delay dst-mix->tint;
#X text 40 80 === WINDOW SETUP ===;
#X obj 40 100 loadbang;
#X obj 40 130 t b b b;
#X msg 40 160 reset , dimen 576 1024 , create , 1;
#X obj 40 190 gemwin;
#X text 40 230 === VIDEO BACKGROUND (always visible) ===;
#X obj 40 260 gemhead 1;
#X obj 40 290 pix_film ../av/mosh_small.mp4;
#X msg 40 320 auto 1;
#X obj 40 350 pix_rgba;
#X text 40 390 === GLITCH CHAIN (video pixels) ===;
#X obj 40 420 pix_brightness;
#X msg 40 450 $1;
#X obj 40 480 r $1-s-vol;
#X obj 40 510 / 127;
#X obj 40 540 * 2;
#X obj 40 570 - 0.5;
#X obj 40 600 pix_contrast;
#X msg 40 630 $1;
#X obj 40 660 r $1-s-drv;
#X obj 40 690 / 127;
#X obj 40 720 * 2;
#X obj 40 750 pix_color;
#X msg 40 780 $1 $2 $3;
#X obj 40 810 r $1-s-sharp-12;
#X obj 40 840 / 127;
#X obj 40 870 * 255;
#X obj 100 810 r $1-s-sharp-34;
#X obj 100 840 / 127;
#X obj 100 870 * 255;
#X obj 160 810 r $1-s-dst-mix;
#X obj 160 840 / 127;
#X obj 160 870 * 255;
#X obj 40 900 pix_hue;
#X msg 40 930 $1;
#X obj 40 960 r $1-s-vibrato;
#X obj 40 990 / 127;
#X obj 40 1020 * 360;
#X obj 40 1050 pix_curve;
#X msg 40 1080 $1 $2;
#X obj 40 1110 r $1-s-mod-12;
#X obj 40 1140 / 127;
#X obj 100 1110 r $1-s-mod-34;
#X obj 100 1140 / 127;
#X obj 40 1170 alpha;
#X msg 40 1200 $1;
#X obj 40 1230 r $1-s-total-fb;
#X obj 40 1260 / 127;
#X obj 40 1290 pix_texture;
#X obj 40 1320 rectangle 4 4;
#X text 40 1370 === COLONY CREATURES (on top of video) ===;
#X obj 40 1400 gemhead 10;
#X obj 40 1430 r $1-s-tune-1;
#X obj 40 1460 / 127;
#X obj 40 1490 * 2;
#X obj 40 1520 - 1;
#X obj 40 1550 translateXYZ;
#X msg 40 1580 $1 $1 0;
#X obj 40 1610 colorRGB 0.8 0.2 0.2;
#X obj 40 1640 alpha 0.6;
#X obj 40 1670 sphere 0.2;
